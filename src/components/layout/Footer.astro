---
import { Image } from 'astro:assets';
import logo from '../../../imgs/Logos/LOGO CONSUC PNG.png';
import company from '../../content/company.json';
---
<footer class="site-footer">
  <div class="container footer-main">
    <a class="footer-brand" href="#inicio" aria-label="CONSUC, volver al inicio"><Image src={logo} alt="CONSUC Servicios Integrales" width={200} format="webp" /></a>
    <p>Ingeniería, construcción, mantenimiento y transporte.<br />Soluciones integrales para tu operación.</p>
    <a class="footer-top" href="#inicio">Volver al inicio</a>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {company.legalName}</span>
    <span>RUC {company.ruc}</span>
    <span>Challhuahuacho · Apurímac · Perú</span>
  </div>
</footer>
