---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import clients from '../../content/clients.json';
import SectionTitle from '../ui/SectionTitle.astro';

const logos = import.meta.glob<ImageMetadata>('../../../imgs/Clientes/*.png', {
  eager: true,
  import: 'default',
});
---
<section class="section clients" id="clientes" aria-label="Nuestros clientes">
  <div class="container">
    <SectionTitle number="05" eyebrow="NUESTROS CLIENTES" title="CONFIANZA QUE NOS IMPULSA." />
    <ul class="clients-list" role="list">
      {clients.map(client => <li>
        <a href={client.url} target="_blank" rel="noopener noreferrer" aria-label={`${client.name}: visitar sitio web (abre en otra pestaña)`}>
          <Image src={logos[`../../../imgs/Clientes/${client.logo}`]} alt={client.name} width={280} format="webp" loading="lazy" />
          <span>{client.name} <span aria-hidden="true">↗</span></span>
        </a>
      </li>)}
    </ul>
    <p class="clients-more">Entre otros.</p>
  </div>
</section>

<style>
  .clients {
    background: var(--bg-main);
    border-top: 1px solid #e7ebee;
  }
  .clients-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    padding: 0;
    margin: 44px 0 0;
    list-style: none;
  }
  .clients-list li {
    flex: 0 0 calc((100% - 60px) / 4);
    min-width: 0;
  }
  .clients-list a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    height: 100%;
    padding: 32px 24px 20px;
    background: white;
    border: 1px solid #e0e6eb;
    border-radius: 10px;
    transition: border-color .2s, box-shadow .2s;
  }
  .clients-list a:hover {
    border-color: var(--color-accent-orange);
    box-shadow: 0 8px 24px #1c2a390d;
  }
  .clients-list img {
    width: 100%;
    height: 85px;
    object-fit: contain;
  }
  .clients-list a > span {
    color: var(--text-heading);
    font-size: .875rem;
    font-weight: 600;
  }
  .clients-list a > span > span {
    margin-left: 5px;
    color: #a74600;
  }
  .clients-more {
    margin-top: 28px;
    text-align: center;
    font-size: 1rem;
  }
  @media (max-width: 800px) {
    .clients-list li { flex-basis: calc((100% - 40px) / 3); }
    .clients-list a { padding: 25px 18px 18px; }
  }
  @media (max-width: 600px) {
    .clients-list { gap: 14px; margin-top: 32px; }
    .clients-list li { flex-basis: calc((100% - 14px) / 2); }
    .clients-list a { padding: 22px 14px 18px; gap: 18px; }
    .clients-list img { height: 65px; }
  }
</style>
