---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import services from '../../content/services.json';
import { whatsappUrl } from '../../lib/whatsapp.mjs';
import Icon from '../ui/Icon.astro';
import SectionTitle from '../ui/SectionTitle.astro';
const images = import.meta.glob<ImageMetadata>('../../assets/references/*.jpg', { eager: true, import: 'default' });
---
<section class="section services" id="servicios" aria-label="Nuestros servicios">
  <div class="container">
    <div class="section-heading-row">
      <SectionTitle number="02" eyebrow="NUESTROS SERVICIOS" title="CAPACIDADES QUE SUMAN A TU PROYECTO." />
      <p>Seis especialidades, un mismo compromiso.<br /> Explora los servicios para tu operación.</p>
    </div>
    <div class="service-carousel" role="region" aria-roledescription="carrusel" aria-label="Categorías de servicios">
      <div class="service-categories" role="group" aria-label="Elegir categoría" hidden>
        {services.map((service, index) => <button type="button" class="service-category" aria-pressed={index === 0 ? 'true' : 'false'} aria-controls={`servicio-${service.slug}`} data-service-index={index}>
          <Icon name={service.id} size={23} /><span>{service.title}</span>
        </button>)}
      </div>
      <div class="service-carousel-controls" hidden>
        <p class="service-position" aria-live="polite" aria-atomic="true"><span data-service-position>01 / 06</span><span data-service-current>Ingeniería</span></p>
        <div class="service-arrows">
          <button type="button" class="service-arrow" data-service-previous aria-label="Servicio anterior" aria-controls="service-track" disabled><span aria-hidden="true">←</span></button>
          <button type="button" class="service-arrow" data-service-next aria-label="Servicio siguiente" aria-controls="service-track"><span aria-hidden="true">→</span></button>
        </div>
      </div>
      <div class="service-track" id="service-track" tabindex="0" aria-label="Servicios: desliza o usa las flechas izquierda y derecha">
        {services.map((service, index) => <article class="service-module" id={`servicio-${service.slug}`} aria-roledescription="diapositiva" aria-label={`${index + 1} de ${services.length}: ${service.title}`}>
          <header class="service-module-heading">
            <div><p class="service-subtitle">{service.subtitle}</p><h3>{service.title}</h3><p class="service-module-summary">{service.summary}</p></div>
            <a class="button button-small" href={whatsappUrl(service.whatsappMessage)} target="_blank" rel="noopener noreferrer" aria-label={`Consultar por WhatsApp: ${service.title}`}><Icon name="chat" size={18} /> Consultar este servicio</a>
          </header>
          <div class="subservices-grid" style={service.subservices.length === 2 ? '--service-columns: 2' : undefined}>
            {service.subservices.map(subservice => <div class="subservice-card">
              <div class="subservice-photo"><Image src={images[`../../assets/references/${subservice.image}`]} alt={subservice.alt} widths={[480, 800]} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw" format="webp" loading="lazy" /></div>
              <div class="subservice-copy"><h4>{subservice.title}</h4><p>{subservice.description}</p></div>
            </div>)}
          </div>
        </article>)}
      </div>
    </div>
    <div class="service-bottom"><p>¿Tu requerimiento combina varios servicios?</p><a href={whatsappUrl('Hola, tengo un proyecto que requiere varios servicios. Quisiera coordinar una consulta con CONSUC SAC.')} target="_blank" rel="noopener noreferrer">Cuéntanos qué necesitas</a></div>
  </div>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>('.service-carousel');
  if (carousel) {
    const track = carousel.querySelector<HTMLElement>('.service-track')!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.service-module'));
    const choices = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-service-index]'));
    const previous = carousel.querySelector<HTMLButtonElement>('[data-service-previous]')!;
    const next = carousel.querySelector<HTMLButtonElement>('[data-service-next]')!;
    const position = carousel.querySelector<HTMLElement>('[data-service-position]')!;
    const currentName = carousel.querySelector<HTMLElement>('[data-service-current]')!;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let destination: number | null = null;
    let frame = 0;
    let width = track.clientWidth;
    const sizeTrack = () => { track.style.height = `${slides[current].offsetHeight}px`; };
    const select = (index: number) => {
      current = index;
      choices.forEach((button, i) => button.setAttribute('aria-pressed', String(i === index)));
      slides.forEach((slide, i) => {
        if (i !== index && slide.contains(document.activeElement)) track.focus({ preventScroll: true });
        slide.inert = i !== index;
        slide.setAttribute('aria-hidden', String(i !== index));
      });
      previous.disabled = index === 0;
      next.disabled = index === slides.length - 1;
      position.textContent = `${String(index + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      currentName.textContent = slides[index].querySelector('h3')!.textContent;
      sizeTrack();
    };
    const goTo = (index: number) => {
      const safeIndex = Math.max(0, Math.min(slides.length - 1, index));
      destination = safeIndex;
      select(safeIndex);
      track.scrollTo({ left: slides[safeIndex].offsetLeft, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
    };
    choices.forEach((button, index) => button.addEventListener('click', () => goTo(index)));
    previous.addEventListener('click', () => goTo(current - 1));
    next.addEventListener('click', () => goTo(current + 1));
    track.addEventListener('keydown', event => {
      if (event.target !== track) return;
      if (['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) {
        event.preventDefault();
        goTo(event.key === 'Home' ? 0 : event.key === 'End' ? slides.length - 1 : current + (event.key === 'ArrowRight' ? 1 : -1));
      }
    });
    const releaseDestination = () => { destination = null; };
    track.addEventListener('pointerdown', releaseDestination);
    track.addEventListener('wheel', releaseDestination, { passive: true });
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        if (destination !== null) {
          if (Math.abs(track.scrollLeft - slides[destination].offsetLeft) > 2) return;
          destination = null;
        }
        const closest = slides.reduce((best, slide, index) => Math.abs(slide.offsetLeft - track.scrollLeft) < Math.abs(slides[best].offsetLeft - track.scrollLeft) ? index : best, 0);
        if (closest !== current) select(closest);
      });
    }, { passive: true });
    const observer = new ResizeObserver(() => {
      if (track.clientWidth !== width) {
        width = track.clientWidth;
        destination = null;
        track.scrollTo({ left: slides[current].offsetLeft, behavior: 'instant' });
      }
      sizeTrack();
    });
    slides.forEach(slide => observer.observe(slide));
    observer.observe(track);
    carousel.querySelectorAll<HTMLElement>('[hidden]').forEach(element => { element.hidden = false; });
    select(0);
  }
</script>

<style>
  [hidden] { display: none !important; }
  .service-categories { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; margin-bottom: 26px; }
  .service-category { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; min-height: 110px; padding: 18px 10px; border: 1px solid #dce3e9; border-radius: 8px; background: white; color: #334155; cursor: pointer; font-size: .875rem; line-height: 1.4; font-weight: 650; }
  .service-category[aria-pressed=true] { background: #1c2a39; color: white; border-color: #1c2a39; box-shadow: inset 0 -4px #f27d16; }
  .service-category:hover { border-color: #a74600; }
  .service-carousel-controls { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
  .service-position { display: flex; gap: 16px; align-items: center; font-size: .875rem; font-weight: 650; }
  [data-service-position] { color: #a74600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .service-arrows { display: flex; gap: 10px; }
  .service-arrow { display: grid; place-items: center; width: 46px; height: 46px; border: 1px solid #cbd5df; border-radius: 50%; background: white; color: #1c2a39; cursor: pointer; font-size: 1.5rem; }
  .service-arrow:hover:enabled { background: #f27d16; border-color: #f27d16; }
  .service-arrow:disabled { opacity: .35; cursor: default; }
  .service-track { display: flex; align-items: flex-start; position: relative; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; border-radius: 10px; }
  .service-track::-webkit-scrollbar { display: none; }
  .service-track:focus-visible { outline: 3px solid #a74600; outline-offset: 4px; }
  .service-module { flex: 0 0 100%; min-width: 0; padding: 30px; scroll-snap-align: start; scroll-snap-stop: always; background: white; border: 1px solid #dce3e9; border-radius: 10px; }
  .service-module-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 32px; margin-bottom: 28px; }
  .service-module-heading > div { max-width: 730px; }
  .service-subtitle { color: #a74600; font-size: .8125rem; font-weight: 650; margin-bottom: 8px; }
  .service-module h3 { font-size: clamp(1.6rem, 3vw, 2.3rem); font-weight: 800; letter-spacing: -.035em; }
  .service-module-summary { font-size: 1rem; margin-top: 12px; line-height: 1.75; }
  .service-module-heading > a { flex-shrink: 0; }
  .subservices-grid { display: grid; grid-template-columns: repeat(var(--service-columns, 3), minmax(0, 1fr)); gap: 20px; }
  .subservice-card { min-width: 0; background: #f4f6f8; border: 1px solid #e3e9ed; border-radius: 8px; overflow: hidden; }
  .subservice-photo { aspect-ratio: 16 / 9; overflow: hidden; background: #e0e6eb; }
  .subservice-photo img { width: 100%; height: 100%; object-fit: cover; }
  .subservice-copy { padding: 20px; }
  .subservice-copy h4 { font-family: var(--font-heading); font-size: 1rem; color: #1c2a39; line-height: 1.45; margin: 0 0 10px; }
  .subservice-copy p { font-size: .9375rem; line-height: 1.75; }
  @media (max-width: 1000px) {
    .service-module-heading { flex-direction: column; gap: 20px; }
    .service-categories { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) { .subservices-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .service-categories { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .service-category { min-height: 76px; padding: 12px 9px; gap: 8px; font-size: .8125rem; flex-direction: row; }
    .service-category :global(svg) { width: 19px; height: 19px; }
    .service-module { padding: 20px 16px; }
    .service-module-heading > a { width: 100%; }
    .subservices-grid { grid-template-columns: 1fr; gap: 18px; }
    .service-position { gap: 8px; flex-direction: column; align-items: flex-start; font-size: .8125rem; }
    .service-module-summary { font-size: .9375rem; }
    .subservice-copy { padding: 18px; }
  }
</style>
